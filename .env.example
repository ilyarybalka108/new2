# Без YD_TOKEN кабинет работает на демо-данных.

# OAuth-токен Яндекс Директа. Одного токена достаточно: кабинеты определяются автоматически —
# клиенты агентства или, если токен не агентский, собственный аккаунт.
# YD_TOKEN=

# Необязательно: задать список логинов клиентов вручную (через запятую), если
# автоматическое определение не подходит.
# YD_CLIENT_LOGINS=client-one,client-two

# Версия API для кампаний, групп, объявлений и фраз. v501 нужна для единых
# перфоманс-кампаний и стоит по умолчанию; v5 — режим совместимости.
# YD_API_VERSION=v501

# Разрешить изменения в боевых кабинетах: паузы, ставки, бюджеты, минус-фразы, создание кампаний.
# По умолчанию боевые кабинеты открываются только на чтение.
# ADS_ALLOW_WRITE=1

# Пароль на вход в кабинет. Обязателен, если кабинет доступен из сети.
# ADS_PASSWORD=

# Каталог для файла состояния (настройки кабинетов, журнал действий). По умолчанию ./data
# ADS_DATA_DIR=data
