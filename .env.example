# Без ADS_ACCOUNTS кабинет работает на демо-данных.

# Список кабинетов (JSON-массив). Токены сюда не пишутся — только имя переменной с токеном.
#   id        — короткий идентификатор латиницей
#   name      — название проекта, как показывать в интерфейсе
#   tokenEnv  — имя переменной окружения с OAuth-токеном Яндекс Директа
#   login     — логин клиента (нужен, если токен агентский)
#   sandbox   — true, чтобы работать с песочницей API, а не с боевым кабинетом
# ADS_ACCOUNTS=[{"id":"project-a","name":"Проект А","tokenEnv":"YD_TOKEN_A"},{"id":"client-b","name":"Клиент Б","tokenEnv":"YD_TOKEN_AGENCY","login":"client-b-login"}]
# YD_TOKEN_A=
# YD_TOKEN_AGENCY=

# Разрешить изменения в боевых кабинетах (пауза, запуск, дневной бюджет).
# По умолчанию боевые кабинеты открываются только на чтение.
# ADS_ALLOW_WRITE=1
